    "./form/checkbox": "./src/desktop/form/Checkbox.tsx",
    "./form/checkbox-group": "./src/desktop/form/CheckboxGroup.tsx",
    "./form/color-picker": "./src/desktop/form/ColorPicker.tsx",
    "./form/date-picker": "./src/desktop/form/DatePicker.tsx",
    "./form/datetime-picker": "./src/desktop/form/DateTimePicker.tsx",
    "./form/form": "./src/desktop/form/Form.tsx",
    "./form/form-item": "./src/desktop/form/FormItem.tsx",
    "./form/form-list": "./src/desktop/form/FormList.tsx",
    "./form/input": "./src/desktop/form/Input.tsx",
    "./form/input-number": "./src/desktop/form/InputNumber.tsx",
    "./form/markdown-editor": "./src/desktop/form/MarkdownEditor.tsx",
    "./form/mentions": "./src/desktop/form/Mentions.tsx",
    "./form/multiselect": "./src/desktop/form/MultiSelect.tsx",
    "./form/password": "./src/desktop/form/Password.tsx",
    "./form/radio": "./src/desktop/form/Radio.tsx",
    "./form/radio-group": "./src/desktop/form/RadioGroup.tsx",
    "./form/rate": "./src/desktop/form/Rate.tsx",
    "./form/rich-text-editor": "./src/desktop/form/RichTextEditor.tsx",
    "./form/search": "./src/desktop/form/Search.tsx",
    "./form/select": "./src/desktop/form/Select.tsx",
    "./form/slider": "./src/desktop/form/Slider.tsx",
    "./form/switch": "./src/desktop/form/Switch.tsx",
    "./form/textarea": "./src/desktop/form/Textarea.tsx",
    "./form/time-picker": "./src/desktop/form/TimePicker.tsx",
    "./form/transfer": "./src/desktop/form/Transfer.tsx",
    "./form/tree-select": "./src/desktop/form/TreeSelect.tsx",
    "./form/upload": "./src/desktop/form/Upload.tsx",
    "./mobile/form/autocomplete": "./src/mobile/form/AutoComplete.tsx",
    "./mobile/form/cascader": "./src/mobile/form/Cascader.tsx",
    "./mobile/form/checkbox": "./src/mobile/form/Checkbox.tsx",
    "./mobile/form/checkbox-group": "./src/mobile/form/CheckboxGroup.tsx",
    "./mobile/form/color-picker": "./src/mobile/form/ColorPicker.tsx",
    "./mobile/form/date-picker": "./src/mobile/form/DatePicker.tsx",
    "./mobile/form/datetime-picker": "./src/mobile/form/DateTimePicker.tsx",
    "./mobile/form/form": "./src/mobile/form/Form.tsx",
    "./mobile/form/form-item": "./src/mobile/form/FormItem.tsx",
    "./mobile/form/form-list": "./src/mobile/form/FormList.tsx",
    "./mobile/form/input": "./src/mobile/form/Input.tsx",
    "./mobile/form/input-number": "./src/mobile/form/InputNumber.tsx",
    "./mobile/form/markdown-editor": "./src/mobile/form/MarkdownEditor.tsx",
    "./mobile/form/mentions": "./src/mobile/form/Mentions.tsx",
    "./mobile/form/multiselect": "./src/mobile/form/MultiSelect.tsx",
    "./mobile/form/number-keyboard": "./src/mobile/form/NumberKeyboard.tsx",
    "./mobile/form/passcode-input": "./src/mobile/form/PasscodeInput.tsx",
    "./mobile/form/password": "./src/mobile/form/Password.tsx",
    "./mobile/form/radio": "./src/mobile/form/Radio.tsx",
    "./mobile/form/radio-group": "./src/mobile/form/RadioGroup.tsx",
    "./mobile/form/rate": "./src/mobile/form/Rate.tsx",
    "./mobile/form/rich-text-editor": "./src/mobile/form/RichTextEditor.tsx",
    "./mobile/form/search": "./src/mobile/form/Search.tsx",
    "./mobile/form/select": "./src/mobile/form/Select.tsx",
    "./mobile/form/signature-pad": "./src/mobile/form/SignaturePad.tsx",
    "./mobile/form/slider": "./src/mobile/form/Slider.tsx",
    "./mobile/form/switch": "./src/mobile/form/Switch.tsx",
    "./mobile/form/textarea": "./src/mobile/form/Textarea.tsx",
    "./mobile/form/time-picker": "./src/mobile/form/TimePicker.tsx",
    "./mobile/form/transfer": "./src/mobile/form/Transfer.tsx",
    "./mobile/form/tree-select": "./src/mobile/form/TreeSelect.tsx",
    "./mobile/form/upload": "./src/mobile/form/Upload.tsx",
    "./mobile/portal": "./src/mobile/MobilePortalHostScope.tsx",
    "./plugin/upload": "./upload.ts"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "plugin.ts",
      "upload.ts",
      "LICENSE",
      "NOTICE",
      "README.md"
    ],
    "exclude": [
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.spec.ts",
      "**/tests/**"
    ]
  },
  "test": {
    "include": [
      "tests/**/*.ts",
      "tests/**/*.tsx"
    ],
    "exclude": [
      "docs/runtime/**",
      "**/deno-cache/**"
    ]
  },
  "tasks": {
    "test": "deno test -A",
    "test:unit": "deno test -A tests/docs-sidebar-reconcile.test.ts",
    "check": "deno check src plugin.ts upload.ts",
    "publish:jsr": "deno publish",
    "publish:jsr:dry-run": "deno publish --dry-run --allow-dirty",
    "test:node": "node --import tsx test-node.mjs"
  },
  "imports": {
    "@dreamer/markdown": "jsr:@dreamer/markdown@^1.1.1",
    "@dreamer/plugin": "jsr:@dreamer/plugin@^1.1.0",
    "@dreamer/logger": "jsr:@dreamer/logger@^1.1.0",
    "@dreamer/runtime-adapter": "jsr:@dreamer/runtime-adapter@^1.2.2",
    "@dreamer/service": "jsr:@dreamer/service@^1.1.0",
    "@dreamer/storage/client": "jsr:@dreamer/storage@^1.1.0/client",
    "@dreamer/test": "jsr:@dreamer/test@^1.2.4",
    "@dreamer/test/browser": "jsr:@dreamer/test@^1.2.4/browser",
    "@dreamer/view": "jsr:@dreamer/view@^3.0.4",
    "@dreamer/upload": "jsr:@dreamer/upload@^2.0.1",
    "@dreamer/upload/adapters": "jsr:@dreamer/upload@^2.0.1/adapters",
    "@dreamer/upload/server": "jsr:@dreamer/upload@^2.0.1/server",
    "@dreamer/image": "jsr:@dreamer/image@^1.1.0",
    "tailwindcss": "npm:tailwindcss@4.3.4",
    "tailwind-merge": "npm:tailwind-merge@3.7.0",
    "chart.js": "npm:chart.js@4.6.1",
    "prismjs": "npm:prismjs@1.30.0"
  },
  "nodeModulesDir": "auto",
  "minimumDependencyAge": 0,
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@dreamer/view",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ]
  },
  "lint": {
    "include": [
      "src/",
      "plugin.ts",
      "upload.ts",
      "tests/"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-explicit-any"
      ]
    }
  },
  "fmt": {
    "exclude": [
      "src/shared/data-display/CodeBlock.tsx"
    ]
  },
  "scopes": {
    "https://jsr.io/@dreamer/server/": {
      "@dreamer/runtime-adapter": "./docs/src/dev/runtime-adapter-hmr-origin.ts",
      "jsr:@dreamer/runtime-adapter@^1.2.2": "./docs/src/dev/runtime-adapter-hmr-origin.ts",
      "jsr:@dreamer/runtime-adapter@1.2.2": "./docs/src/dev/runtime-adapter-hmr-origin.ts"
    },
    "https://jsr.io/@dreamer/dweb/": {
      "@dreamer/runtime-adapter": "./docs/src/dev/runtime-adapter-hmr-origin.ts",
      "jsr:@dreamer/runtime-adapter@^1.2.2": "./docs/src/dev/runtime-adapter-hmr-origin.ts",
      "jsr:@dreamer/runtime-adapter@1.2.2": "./docs/src/dev/runtime-adapter-hmr-origin.ts"
    }
  }
}
